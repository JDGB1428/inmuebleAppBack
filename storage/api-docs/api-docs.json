                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Inmuebles"
                ],
                "summary": "Crear un nuevo inmueble",
                "description": "Crea un inmueble permitiendo subir una o múltiples imágenes.",
                "operationId": "8c7827ef2ca1e03a483245ee65a13b37",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "title",
                                    "price",
                                    "state"
                                ],
                                "properties": {
                                    "title": {
                                        "description": "Título del inmueble",
                                        "type": "string"
                                    },
                                    "price": {
                                        "description": "Precio",
                                        "type": "number"
                                    },
                                    "state": {
                                        "description": "Estado (ej. available, rented)",
                                        "type": "string"
                                    },
                                    "image[]": {
                                        "description": "Arreglo de imágenes a subir",
                                        "type": "array",
                                        "items": {
                                            "type": "string",
                                            "format": "binary"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Inmueble creado correctamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "data": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
